CHANGE_ME


# ==========================================# ==========================================
# AGENT-CI-LENS: SECRETS & CONFIG (v5.2)
# ==========================================

# ------------------------------------------
# 1. SYSTEM CONTROL (Simulation & Testing)
# ------------------------------------------
# true  = Agenti aj GHA sú len simulácia (zadarmo/bezpečne).
# false = LIVE (Míňajú sa kredity, volá sa reálne GitHub API).
MOCK=false

# Výsledok simulovaného GitHub Action (len ak MOCK=true).
# Options: success, failure
GHA_MOCK_RESULT=success


# ------------------------------------------
# 2. ACTIVE API KEYS (Production)
# ------------------------------------------

# GROQ: Zodpovedný za rýchlosť (Developer, Pedant)
GROQ_API_KEY=CHANGE_ME
GROQ_BASE_URL=https://api.groq.com/openai/v1

# MISTRAL: Zodpovedný za kvalitu uvažovania (Queen, Auditor)
MISTRAL_API_KEY=CHANGE_ME
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# GITHUB: Voliteľný pre GHA v2 (Cloud Push)
GITHUB_TOKEN=CHANGE_ME
GITHUB_REPOSITORY=OpenXFlow/ci-dev-lens_test

# LLM Endpoint (Voliteľné - len ak používaš GitHub ako AI providera)
# PROVIDER_GITHUB_BASE_URL=https://models.inference.ai.azure.com


# GEMINI: Voliteľný (OpenAI compatible)
GEMINI_API_KEY=CHANGE_ME
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai


# ------------------------------------------
# 3. POKROČILÉ NASTAVENIA (Resilience & Local)
# ------------------------------------------

# ➤ LEVEL 1: KEY ROTATION (Vysoká dostupnosť)
# Orchestrátor automaticky rotuje kľúče oddelené čiarkou.
# Ak prvý kľúč vráti chybu (429 Rate Limit alebo 401 Unauthorized),
# systém okamžite skúsi nasledujúci kľúč v zozname bez pádu pipeline.
#
# Príklad:
# GROQ_API_KEY=gsk_primary,gsk_backup_1,gsk_backup_2

# ➤ LEVEL 2: SMART FALLBACK (Disaster Recovery)
# Ak zlyhajú VŠETKY kľúče primárneho providera (napr. Groq má výpadok),
# systém sa pozrie do agent_config.json (fallback_matrix) a automaticky
# prepne agenta na záložného providera (napr. Mistral).

# ➤ LEVEL 3: LOCAL LLM (Ollama / LM Studio)
# Pre použitie lokálneho modelu (zadarmo/offline) stačí odkomentovať.
# Systém to rozpozná ako štandardný OpenAI-compatible endpoint.
#
# OLLAMA_API_KEY=dummy
# OLLAMA_BASE_URL=http://localhost:11434/v1