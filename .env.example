# ==========================================
# AGENT-CI-LENS: SECRETS & CONFIG (v5.2)
# ==========================================

# ------------------------------------------
# 1. SYSTEM CONTROL (Simulation & Testing)
# ------------------------------------------
# true  = Agents and GHA are simulated (free/safe).
# false = LIVE (Real credits used, real GitHub API calls).
MOCK=false

# Result of the simulated GitHub Action (only if MOCK=true).
# Options: success, failure
GHA_MOCK_RESULT=success


# ------------------------------------------
# 2. ACTIVE API KEYS (Production)
# ------------------------------------------

# GROQ: Optimized for Speed (Developer, Pedant)
GROQ_API_KEY=gsk_CHANGE_ME
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# MISTRAL: Optimized for Reasoning (Queen, Auditor)
MISTRAL_API_KEY=CHANGE_ME
MISTRAL_BASE_URL=https://api.mistral.ai/v1/chat/completions

# GITHUB: Optional for GHA v2 (Cloud Push)
GITHUB_TOKEN=github_pat_CHANGE_ME
PROVIDER_GITHUB_URL=https://models.inference.ai.azure.com/chat/completions

# GEMINI: Optional (OpenAI compatible)
GEMINI_API_KEY=AIzaSy_CHANGE_ME
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions


# ------------------------------------------
# 3. ADVANCED CONFIGURATION (Resilience & Local)
# ------------------------------------------

# ➤ LEVEL 1: KEY ROTATION (High Availability)
# The Orchestrator automatically rotates comma-separated keys.
# If the first key returns an error (429 Rate Limit or 401 Unauthorized),
# the system instantly tries the next key in the list without crashing.
#
# Example:
# GROQ_API_KEY=gsk_primary,gsk_backup_1,gsk_backup_2

# ➤ LEVEL 2: SMART FALLBACK (Disaster Recovery)
# If ALL keys for the primary provider fail (e.g., Groq outage),
# the system checks agent_config.json (fallback_matrix) and automatically
# switches the agent to the backup provider (e.g., Mistral).

# ➤ LEVEL 3: LOCAL LLM (Ollama / LM Studio)
# To use a local model (free/offline), simply uncomment the lines below.
# The system recognizes it as a standard OpenAI-compatible endpoint.
#
# OLLAMA_API_KEY=dummy
# OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions